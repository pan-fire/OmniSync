tui/pathlib
tui/osync-tui

# --- Secrets and local data (never commit; gitleaks also checks) ---
# rclone configs hold every remote's OAuth tokens and keys.
rclone.conf
*.rclone.conf
# Private keys and certificates.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# OmniSync's data directory when run outside Docker (OMNISYNC_*_PATH
# pointed at the checkout): database, API token, VAPID keys, bisync state.
/data/
/omnisync-data/
*.db
*.db-journal
*.db-wal
*.db-shm
api-token
# The TUI's config file holds the API key (tui/README.md).
tui.toml

# --- Coverage output (backend: see Testing above) ---
/frontend/coverage/
coverage.out
*.coverprofile
coverage-*.xml
lcov.info

# --- Misc ---
