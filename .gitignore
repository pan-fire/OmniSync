# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class

# tmp and bkps

*tmp
*temp
*bkp
*backup

# --- C extensions ---
*.so

# --- Distribution / packaging ---
/bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
sdist/
/var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
# It is best practice to keep these out of source control
.venv/
venv/
ENV/
env/
# For specialized environments like Conda or Poetry
.python-version
.poetry/
.pdm.toml
.pdm-python
.pdm-build/

# --- FastAPI / Web Framework Specifics ---
# Environment variables (Never commit these!): .env, .env.local,
# .env.production, .envrc, ...
.env*
!.env.example
# Static files generated by certain libraries
static/upload/
media/

