# Coverage of the backend code (CI: pytest --cov=backend, run from backend/).
[run]
# SQLAlchemy's async calls switch greenlets: without greenlet tracing,
# coverage loses a route body after its first database call.
concurrency = greenlet, thread
omit =
    */backend/tests/*

[report]
# The measured total (lines and branches, 96.7%) minus a margin; raise
# it as coverage grows.
fail_under = 95
